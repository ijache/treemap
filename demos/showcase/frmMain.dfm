object FormMain: TFormMain
  Left = 0
  Top = 0
  Caption = 'Treemap Component Demo by Rezar Behzad & Ingo Jache'
  ClientHeight = 589
  ClientWidth = 1029
  Color = clBtnFace
  Font.Charset = DEFAULT_CHARSET
  Font.Color = clWindowText
  Font.Height = -12
  Font.Name = 'Segoe UI'
  Font.Style = []
  OldCreateOrder = True
  Position = poScreenCenter
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  PixelsPerInch = 96
  TextHeight = 15
  object StatusBar1: TStatusBar
    Left = 0
    Top = 570
    Width = 1029
    Height = 19
    Panels = <>
  end
  object Panel1: TPanel
    Left = 0
    Top = 0
    Width = 199
    Height = 570
    Align = alLeft
    TabOrder = 1
    object Label1: TLabel
      Left = 5
      Top = 8
      Width = 185
      Height = 58
      Alignment = taCenter
      AutoSize = False
      Caption = 
        'This demo shows how to dynamically add/remove items aswell as ne' +
        'sted treemaps. '
      WordWrap = True
    end
    object Label2: TLabel
      Left = 5
      Top = 218
      Width = 185
      Height = 57
      Alignment = taCenter
      AutoSize = False
      Caption = 
        'You can select/deselect items via mouseclick. Hold shift to sele' +
        'ct multiple items'
      WordWrap = True
    end
    object Label3: TLabel
      Left = 5
      Top = 335
      Width = 185
      Height = 36
      Alignment = taCenter
      AutoSize = False
      Caption = 'Press this button to save PNG of this treemap'
      WordWrap = True
    end
    object Label4: TLabel
      Left = 5
      Top = 66
      Width = 185
      Height = 39
      Alignment = taCenter
      AutoSize = False
      Caption = 'Resize the window to see redraw speeds in action'
      WordWrap = True
    end
    object Button1: TButton
      Left = 5
      Top = 130
      Width = 185
      Height = 25
      Caption = 'More Subitems'
      TabOrder = 0
      OnClick = Button1Click
    end
    object Button2: TButton
      Left = 5
      Top = 161
      Width = 185
      Height = 25
      Caption = 'Clear Subitems'
      TabOrder = 1
      OnClick = Button2Click
    end
    object Button3: TButton
      Left = 5
      Top = 377
      Width = 185
      Height = 25
      Caption = 'Save Image'
      TabOrder = 2
      OnClick = Button3Click
    end
  end
  object SaveDialog1: TSaveDialog
    DefaultExt = 'PNG'
    Filter = 'PNG-Files|*.png'
    Left = 136
    Top = 272
  end
